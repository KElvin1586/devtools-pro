# DevTools Pro — build-time commercial configuration
#
# Copy this file to `.env` (or set the variables in your hosting provider's
# build settings) and rebuild for the values to take effect. Vite inlines
# VITE_* variables into the public JavaScript bundle at build time.
#
# ⚠ NEVER put private API keys, payment-provider secret keys, webhook
#   signing secrets, or any other credentials in VITE_* variables.
#   Everything here is shipped publicly to every visitor's browser.
#   The checkout link below is public by design; license verification uses
#   Lemon Squeezy's public License API, which requires no credentials.

# The real Lemon Squeezy checkout for Premium (production default).
# Customers pay here and receive a license key, which they activate in the
# app (#/activate); the key is verified against Lemon Squeezy's License API.
# See PRICING.md for the full flow.
VITE_UPGRADE_URL=https://kelvindigitaltools.lemonsqueezy.com/checkout/buy/5a9a0680-dbb4-4c1b-b38c-02c8bbd20fe1

# Premium one-time price shown to users (number, major units).
# The Lemon Squeezy product is priced in KES; buyers in other currencies
# see an automatic conversion at checkout.
VITE_PREMIUM_PRICE=1299

# ISO 4217 currency code for the premium price.
VITE_PREMIUM_CURRENCY=KES

# Approximate USD equivalent of the KES price, shown next to it in the UI
# (display only — Lemon Squeezy handles the real conversion at checkout).
VITE_PREMIUM_PRICE_USD=10.04
