# DevTools Pro — build-time commercial configuration
#
# Copy this file to `.env` (or set the variables in your hosting provider's
# build settings) and rebuild for the values to take effect. Vite inlines
# VITE_* variables into the public JavaScript bundle at build time.
#
# ⚠ NEVER put private API keys, payment-provider secret keys, or any other
#   credentials in VITE_* variables. Everything here is shipped publicly to
#   every visitor's browser. Payment providers only need a PUBLIC checkout
#   link here — secret keys stay on the provider's side.

# The real checkout/payment URL for Premium (REQUIRED to sell Premium).
# Create the product and a checkout/payment link in your payment provider
# (Stripe Payment Link, Lemon Squeezy, Gumroad, Paddle, …) and paste the
# public link here. See PRICING.md for the full step-by-step guide.
#
# Until a real URL is set, the upgrade button falls back to the app's
# internal #/checkout page, which states clearly that no payment is
# processed there.
VITE_UPGRADE_URL=https://YOUR_REAL_CHECKOUT_URL

# Premium one-time price shown to users (number, major units).
VITE_PREMIUM_PRICE=9.99

# ISO 4217 currency code for the premium price.
VITE_PREMIUM_CURRENCY=USD
